<winex:WindowEx
    x:Class="Allowance.Drawer.DrawerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winex="using:WinUIEx"
    Title="Allowance">
    <!--  The window is invisible and the card draws everything. Margin 24 keeps the shadow from being clipped.  -->
    <Grid x:Name="Root" Background="Transparent" KeyDown="OnRootKeyDown">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <StaticResource x:Key="MessageBrush" ResourceKey="SystemFillColorCautionBrush" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <StaticResource x:Key="MessageBrush" ResourceKey="SystemFillColorCautionBrush" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <ContentControl
            x:Name="Card"
            Width="440"
            Margin="24"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource AllowanceCard}">
            <StackPanel Padding="20,14,14,20">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="Plan usage limits" />
                    <TextBlock
                        x:Name="PlanText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="UpdatedText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button
                        x:Name="RefreshButton"
                        Grid.Column="3"
                        Width="32"
                        Height="32"
                        Padding="0"
                        AutomationProperties.Name="Refresh"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnRefreshClick"
                        ToolTipService.ToolTip="Refresh">
                        <Grid>
                            <FontIcon
                                x:Name="RefreshGlyph"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Glyph="&#xE72C;" />
                            <ProgressRing
                                x:Name="RefreshRing"
                                Width="16"
                                Height="16"
                                IsActive="False"
                                Visibility="Collapsed" />
                        </Grid>
                    </Button>
                </Grid>

                <StackPanel x:Name="Body" Margin="0,14,6,0" Spacing="16">
                    <StackPanel x:Name="SessionRows" Spacing="16" />
                    <TextBlock
                        x:Name="WeeklyHeading"
                        Margin="0,8,0,0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="Weekly limits"
                        Visibility="Collapsed" />
                    <StackPanel x:Name="WeeklyRows" Spacing="16" />
                    <StackPanel x:Name="BreakdownPanel" Spacing="8" Visibility="Collapsed">
                        <Button
                            x:Name="BreakdownToggle"
                            Margin="-8,0,-8,0"
                            Padding="8,6"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="Show what's using your allowance"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnBreakdownClick">
                            <Grid>
                                <TextBlock FontSize="14" Text="What's using your allowance" />
                                <FontIcon
                                    x:Name="BreakdownChevron"
                                    HorizontalAlignment="Right"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="12"
                                    Glyph="&#xE70D;" />
                            </Grid>
                        </Button>
                        <ScrollViewer x:Name="BreakdownScroll" MaxHeight="320" Visibility="Collapsed">
                            <StackPanel x:Name="BreakdownBody" Padding="0,0,12,0" Spacing="14" />
                        </ScrollViewer>
                    </StackPanel>
                    <TextBlock
                        x:Name="MessageText"
                        AutomationProperties.LiveSetting="Assertive"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </ContentControl>
    </Grid>
</winex:WindowEx>
