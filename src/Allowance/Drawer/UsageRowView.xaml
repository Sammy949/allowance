<UserControl
    x:Class="Allowance.Drawer.UsageRowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="128" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="72" />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="4">
            <TextBlock x:Name="LabelText" FontSize="14" TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="ResetText"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Grid x:Name="BarArea" Grid.Column="1" VerticalAlignment="Center" Background="Transparent">
        <ProgressBar
            x:Name="Bar"
            MinHeight="8"
            VerticalAlignment="Center"
            Background="#402F7FE0"
            CornerRadius="4"
            Foreground="#2F7FE0"
            Maximum="100"
            Minimum="0">
            <ProgressBar.Resources>
                <x:Double x:Key="ProgressBarTrackHeight">8</x:Double>
            </ProgressBar.Resources>
        </ProgressBar>
            <!--  The tick marks how much of the window has passed. A bar past the tick is burning faster than time.  -->
            <Grid x:Name="PaceLayer" IsHitTestVisible="False" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PaceDone" Width="*" />
                    <ColumnDefinition x:Name="PaceLeft" Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="1"
                    Width="2"
                    Height="16"
                    Margin="-1,0,0,0"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource TextFillColorPrimaryBrush}"
                    CornerRadius="1" />
            </Grid>
        </Grid>

        <TextBlock
            x:Name="PercentText"
            Grid.Column="2"
            VerticalAlignment="Center"
            FontSize="13"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextAlignment="Right" />
    </Grid>
</UserControl>
